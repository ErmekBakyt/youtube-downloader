@using System.Text.Encodings.Web
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer L

@{
    ViewData["Title"] = L["Title"];
    Layout = "_Layout";
}


<script>
  // JS için lokalize metinler
  window.i18n = {
    invalidUrl: "@JavaScriptEncoder.Default.Encode(L["InvalidUrl"].Value)",
    exampleUrl: "@JavaScriptEncoder.Default.Encode(L["ExampleUrl"].Value)",
    serverError: "@JavaScriptEncoder.Default.Encode(L["ServerError"].Value)",
    fetchFailed: "@JavaScriptEncoder.Default.Encode(L["FetchFailed"].Value)",
    videoInfoLoading: "@JavaScriptEncoder.Default.Encode(L["VideoInfoLoading"].Value)",
    analyze: "@JavaScriptEncoder.Default.Encode(L["Analyze"].Value)",
    analyzing: "@JavaScriptEncoder.Default.Encode(L["Analyzing"].Value)",
    retry: "@JavaScriptEncoder.Default.Encode(L["Retry"].Value)",
    qualitySelect: "@JavaScriptEncoder.Default.Encode(L["QualitySelect"].Value)",
    qualityChoose: "@JavaScriptEncoder.Default.Encode(L["QualityChoose"].Value)",
    download: "@JavaScriptEncoder.Default.Encode(L["Download"].Value)",
    preparing: "@JavaScriptEncoder.Default.Encode(L["Preparing"].Value)",
    downloaded: "@JavaScriptEncoder.Default.Encode(L["Downloaded"].Value)",
    downloadError: "@JavaScriptEncoder.Default.Encode(L["DownloadError"].Value)",
    downloadingWait: "@JavaScriptEncoder.Default.Encode(L["DownloadingWait"].Value)",
    viewsLabel: "@JavaScriptEncoder.Default.Encode(L["ViewsLabel"].Value)",
    newSearch: "@JavaScriptEncoder.Default.Encode(L["NewSearch"].Value)",
    noFormats: "@JavaScriptEncoder.Default.Encode(L["NoFormats"].Value)",
    audioLabel: "@JavaScriptEncoder.Default.Encode(L["AudioLabel"].Value)",
    recommended: "@JavaScriptEncoder.Default.Encode(L["Recommended"].Value)"
  };
</script>
<form id="antiForgeryForm" method="post" style="display:none">
    @Html.AntiForgeryToken()
</form>
<div class="hero-section">
    <div class="container">
        <div class="hero-content text-center">
            <div class="logo-wrapper">
                <div class="logo-icon">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z" fill="currentColor"/>
                    </svg>
                </div>
                <h1 class="brand-title">YTDownloader</h1>
            </div>
            <p class="hero-subtitle">@Html.Raw(L["HeroSubtitleHtml"].Value)</p>
        </div>

        <!-- URL Input Card -->
        <div class="search-card">
            <div class="search-input-wrapper">
                <div class="yt-icon">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="#FF0000">
                        <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                    </svg>
                </div>
                <input type="text"
                       id="urlInput"
                       class="url-input"
                       placeholder="@L["UrlPlaceholder"]"
                       autocomplete="off"
                       spellcheck="false" />
                <button id="fetchBtn" class="fetch-btn" onclick="fetchVideoInfo()">
                    <span class="btn-text">@L["Analyze"]</span>
                    <svg class="btn-arrow" viewBox="0 0 24 24" fill="none">
                        <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
            </div>
            <p class="search-hint">@L["HintExamplePrefix"] @L["ExampleUrl"]</p>
        </div>

        <!-- Loading State -->
        <div id="loadingSection" class="loading-section hidden">
            <div class="loading-spinner">
                <div class="spinner-ring"></div>
                <div class="spinner-ring"></div>
                <div class="spinner-ring"></div>
            </div>
            <p class="loading-text">@L["VideoInfoLoading"]</p>
        </div>

        <!-- Error State -->
        <div id="errorSection" class="error-section hidden">
            <div class="error-card">
                <div class="error-icon">⚠️</div>
                <p id="errorMessage" class="error-message"></p>
                <button class="retry-btn" onclick="resetState()">@L["Retry"]</button>
            </div>
        </div>

        <!-- Video Info Card -->
        <div id="videoSection" class="video-section hidden">
            <div class="video-card">
                <div class="video-card-inner">
                    <!-- Thumbnail -->
                    <div class="thumbnail-container">
                        <img id="videoThumbnail" src="" alt="@L["ThumbnailAlt"]" class="thumbnail" />
                        <div class="thumbnail-overlay">
                            <div class="play-badge">
                                <svg viewBox="0 0 24 24" fill="white" width="32" height="32">
                                    <path d="M8 5v14l11-7z"/>
                                </svg>
                            </div>
                        </div>
                        <div id="videoDuration" class="duration-badge"></div>
                    </div>

                    <!-- Video Meta -->
                    <div class="video-meta">
                        <h2 id="videoTitle" class="video-title"></h2>
                        <div class="video-stats">
                            <span class="stat">
                                <svg viewBox="0 0 24 24" fill="none" width="16" height="16">
                                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z" fill="currentColor"/>
                                </svg>
                                <span id="videoAuthor"></span>
                            </span>
                            <span class="stat">
                                <svg viewBox="0 0 24 24" fill="none" width="16" height="16">
                                    <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3-3-1.34-3-3 1.34-3 3-3z" fill="currentColor"/>
                                </svg>
                                <span id="videoViews"></span> <span id="viewsLabel">@L["ViewsLabel"]</span>
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Format Selection -->
                <div class="format-section">
                    <h3 class="format-title">
                        <svg viewBox="0 0 24 24" fill="none" width="20" height="20">
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                        </svg>
                        @L["QualityChoose"]
                    </h3>
                    <div id="formatGrid" class="format-grid"></div>
                </div>

                <!-- Download Button -->
                <div class="download-section">
                    <button id="downloadBtn" class="download-btn" onclick="downloadVideo()" disabled>
                        <svg viewBox="0 0 24 24" fill="none" width="22" height="22">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span id="downloadBtnText">@L["QualitySelect"]</span>
                    </button>
                    <p class="download-hint">@L["DownloadHint"]</p>
                </div>

                <!-- Download Progress -->
                <div id="downloadProgress" class="download-progress hidden">
                    <div class="progress-bar-container">
                        <div id="progressFill" class="progress-bar-fill" style="width:0%"></div>
                    </div>
                    <p id="progressText" class="progress-text">@L["DownloadingWait"]</p>
                </div>
            </div>

            <!-- New Search Button -->
            <button class="new-search-btn" onclick="resetState()">
                <svg viewBox="0 0 24 24" fill="none" width="18" height="18">
                    <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                @L["NewSearch"]
            </button>
        </div>

        <!-- Features Section -->
        <div id="featuresSection" class="features-section">
            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon">⚡</div>
                    <h4>@L["FeatureFastTitle"]</h4>
                    <p>@L["FeatureFastDesc"]</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">🎯</div>
                    <h4>@L["FeatureQualityTitle"]</h4>
                    <p>@L["FeatureQualityDesc"]</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">🎵</div>
                    <h4>@L["FeatureMp3Title"]</h4>
                    <p>@L["FeatureMp3Desc"]</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">🔒</div>
                    <h4>@L["FeatureSecureTitle"]</h4>
                    <p>@L["FeatureSecureDesc"]</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/downloader.js"></script>
}